import aiohttp

class DataExtractor:
    async def extract_key_data(self, papers: list, query: str) -> dict:
        
        context = "\n".join(f"{p['title']} ({p['year']})" for p in papers)
        prompt = f"""
        Extract specific data about {query} from these papers:
        {context}
        Focus on: treatment protocols, success rates, side effects.
        """
        
        async with aiohttp.ClientSession() as session:
            payload = {
                "model": "deepseek-v2",  # Hardcoded for technical extraction
                "messages": [{"role": "user", "content": prompt}],
                "temperature": 0.1
            }
            async with session.post(
                "https://anura-testnet.lilypad.tech/api/v1/chat/completions",
                json=payload
            ) as resp:
                data = await resp.json()
                return {
                    "query": query,
                    "extracted_data": data["choices"][0]["message"]["content"]
                }
